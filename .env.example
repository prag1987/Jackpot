# Copy to .env on the VPS:  cp .env.example .env   — NEVER commit .env

# Dashboard login (long random string)
CG_ADMIN_PASSWORD=change-me-to-a-long-random-password
# Encrypts Dhan credentials saved from the dashboard. Generate:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CG_ENCRYPTION_KEY=

# Dhan LIVE account (also used for market data). Can instead be saved from dashboard.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Dhan SANDBOX (developer.dhanhq.co → Sandbox tab). Orders here use no real money.
DHAN_SANDBOX_CLIENT_ID=
DHAN_SANDBOX_ACCESS_TOKEN=
# Verify the sandbox base URL in the sandbox API docs and change if needed:
# DHAN_SANDBOX_BASE_URL=https://sandbox.dhan.co/v2

# ---- LIVE locks ----
# The VPS static IP that you whitelisted in Dhan (web.dhan.co → DhanHQ APIs)
CG_STATIC_IP=
# Real-money orders stay impossible until this is exactly YES
CG_ALLOW_LIVE=NO

# Optional Telegram alerts (BotFather token + your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
